# The provider kit and its socket guard are imported by conftest.py, which is
# tracked. `tests/*` below re-excludes the directory, so without these lines
# they are ignored *and* required: a clone gets a conftest that fails on
# `import fake_provider` and every suite errors before collection.
!tests/fake_provider.py
!tests/network_guard.py

# The CI scanner is tracked; the rest of scripts/ is local tooling.
!scripts/
scripts/*
!scripts/scan_secrets.py
!scripts/scan_security.py
!scripts/HOW_TO_UPDATE_ORIGIN_FROM_UPSTREAM.md

